# This rule enforces the --gs-n-* / --gs-px calc-token pattern.
# Several surfaces in the repo have their own self-contained design
# systems with parallel token namespaces — those are intentional and
# should not be forced through the public --gs-* system.

# Admin tree: --admin-space-* tokens + pragmatic micro-pixel values
# (1–10px) for chrome tuning below the public spacing scale.
src/app/admin/
src/components/admin/

# RQ quiz + visualizations: --rq-* token namespace, separate visual
# rhythm tuned for the quiz/results UX.
src/app/rq-quiz/
src/components/rq/

# XQ Conviction Quotient quiz: --xq-* token namespace, mirrors RQ's
# exemption pattern. Self-contained public surface with its own token
# system tuned to match the RQ quiz visual language.
src/app/xq-quiz/

# XQ Characters gallery: extends the --xq-* token namespace; review
# surface for the 8 archetype illustrations + spectrum map. The v2
# variant (xq-characters2) renders the same content with 3D-style
# SVG illustrations.
src/app/xq-characters/
src/app/xq-characters2/
src/components/xq/

# /x-deck — trading-card matching preview surface. Uses --xq-* plus
# a few page-local card tokens (--xd-*). Standalone preview page for
# iterating on the deck visual before wiring it to the XQ result flow.
src/app/x-deck/

# Design-system showcase page: --ds-* tokens, internal tooling page
# that demonstrates the public token system without consuming it.
src/app/design-system/

# /world — marketplace RPG, fullscreen Phaser canvas host with its own
# game-grid geometry. Public spacing scale doesn't apply.
src/app/world/

# Generated by the token build script; not a hand-edited surface.
src/styles/generated-tokens.css

# Build output + deps.
.next/
node_modules/

# Stylelint's own JSON report (gitignored separately).
.stylelint-report.json
