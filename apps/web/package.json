{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run tokens:build",
    "dev": "next dev",
    "prebuild": "npm run tokens:build",
    "build": "next build",
    "prestart": "npm run tokens:build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && node scripts/ensure-next-types.mjs && tsc --noEmit --incremental false",
    "tokens:build": "node scripts/build-tokens.mjs",
    "assets:audit": "node scripts/audit-public-assets.mjs --check",
    "assets:manifest": "node scripts/audit-public-assets.mjs --write-manifest",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@vercel/og": "^0.11.1",
    "gsap": "^3.14.2",
    "lottie-react": "^2.4.1",
    "motion": "^12.33.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "split-type": "^0.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
