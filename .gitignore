# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log

# Env (keep examples)
.env
.env.*
!.env.example

# Node / Next
**/node_modules/
**/.next/
**/out/
**/dist/
**/.turbo/
**/.vercel/

# This repo folder currently contains internal docs/assets.
# Only commit what we intentionally use for the public website.
companyfolder/
context/
documented_posts/
social_media_strategy/
welcome document/
ghost_signal_all_social_posts_pack.txt
improved_social_posts_pack.txt
best_posting_times.md
social_media_posts.md
extract_pdf.py

# Local reference screenshots (not for repo)
screenhots/

# Raw design assets (local-only).
# Keep shipped assets under apps/web/public/ instead.
assets/**
!assets/README.md
!assets/.gitkeep

# Local tool/agent settings
# Ignore everything under .claude/ EXCEPT the shareable project config
# (skills, agents, slash commands, and the team-shared settings.json).
# Personal stuff like settings.local.json and transcripts stays ignored.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
.grok/

# Temporary files
.tmp-*
nul

# Vendor credentials dropped in the repo (never commit raw tokens)
apps/web/ART19TOKEN.txt

# Private CRM exports — Nimble contacts are private security info.
# These hold PII (names, emails, phones, owners) for external
# contacts and must never be committed to the repo.
nimble_*.csv
**/nimble_*.csv
docs/nimble_*

# Local Supabase snapshots (taken before destructive migrations).
# Each dir holds full PII dumps of contacts/members/etc — must stay
# local. Restore via apps/web/scripts/restore-from-snapshot.mjs.
backups/


# Personal local-only tools served off the dev server (never deployed).
# The social-posting checklist is Martin's private tick-list; it lives
# in public/ so `next dev` serves it at /social-checklist.html, but it
# must not ship to prod.
apps/web/public/social-checklist.html
apps/web/public/social-checklist.js
